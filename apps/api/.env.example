# Local development environment template for apps/api.
# `./dev-setup.sh up` will copy this file to `apps/api/.env` if it is missing.

# App runtime
APP_NAME=Ragdoll API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Supports a single origin, comma-separated origins, or a JSON array of strings.
ALLOWED_ORIGINS=http://localhost:8030
API_HOST=0.0.0.0
API_PORT=8000

# Database
SUPABASE_DB_URL=postgresql://postgres:your_password@db.example.supabase.co:5432/postgres
# Optional legacy fallback fields if SUPABASE_DB_URL is omitted
# SUPABASE_POSTGRES_HOST=db.example.supabase.co
# SUPABASE_POSTGRES_PORT=5432
# SUPABASE_POSTGRES_DB=postgres
# SUPABASE_POSTGRES_USER=postgres
# SUPABASE_POSTGRES_PASSWORD=your_password

# Supabase API / storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=documents

# Security
SECRET_KEY=replace-me-before-shared-runtime-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_WORKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Feature flags and limits
FEATURE_FLAG_UNIFIED_SEARCH=true
UPLOAD_RATE_LIMIT_ENABLED=true
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
