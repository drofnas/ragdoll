# Local development environment template for apps/api.
# `./dev-setup.sh up` will copy this file to `apps/api/.env` if it is missing.
# `./dev-setup.sh infra up` will also hydrate local-infra values in `apps/api/.env`
# when they are still placeholders or old scaffold defaults.

# App runtime
APP_NAME=Ragdoll API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SQL_ECHO=false
# Supports a single origin, comma-separated origins, or a JSON array of strings.
ALLOWED_ORIGINS=http://localhost:8030
API_HOST=0.0.0.0
API_PORT=8000

# Database
SUPABASE_DB_URL=postgresql://postgres:replace-with-local-postgres-password@db:5432/postgres
# Host-local alternative when not running inside Docker: postgresql://postgres:replace-with-local-postgres-password@localhost:15432/postgres
# Optional legacy fallback fields if SUPABASE_DB_URL is omitted
# SUPABASE_POSTGRES_HOST=db
# SUPABASE_POSTGRES_PORT=5432
# SUPABASE_POSTGRES_DB=postgres
# SUPABASE_POSTGRES_USER=postgres
# SUPABASE_POSTGRES_PASSWORD=replace-with-local-postgres-password

# Supabase API / storage
SUPABASE_URL=http://kong:8000
# Host-local alternative when not running inside Docker: http://localhost:18000
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# Queue
REDIS_URL=redis://redis:6379/0
# Host-local alternative when not running inside Docker: redis://localhost:16379/0
DOCUMENT_PROCESSING_QUEUE_NAME=document-processing
DOCUMENT_PROCESSING_JOB_TIMEOUT_SECONDS=2700
DOCUMENT_PROCESSING_RESULT_TTL_SECONDS=86400
DOCUMENT_PROCESSING_FAILURE_TTL_SECONDS=604800

# Security
SECRET_KEY=replace-me-before-shared-runtime-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Shared E2E user
E2E_TEST_USER_EMAIL=tests@ragdoll.local
E2E_TEST_USER_PASSWORD=testpass123
E2E_TEST_USER_FULL_NAME=Ragdoll E2E Test User

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_WORKER_BASE_URL=http://ollama:11434
# Host-local alternative when not running inside Docker: http://localhost:13434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ENTITY_EXTRACTION_MODE=auto
ENTITY_EXTRACTION_BATCH_SIZE=4
ENTITY_EXTRACTION_MAX_PARALLEL_BATCHES=2
OLLAMA_WORKER_TIMEOUT_SECONDS=120
OLLAMA_CHAT_TIMEOUT_SECONDS=45
OLLAMA_STATUS_CHAT_TIMEOUT_SECONDS=45
OLLAMA_CHAT_MAX_TOKENS=700
OLLAMA_CHAT_CONTEXT_WINDOW=4096
OLLAMA_CHAT_THINK=false

# Feature flags and limits
FEATURE_FLAG_UNIFIED_SEARCH=true
UPLOAD_RATE_LIMIT_ENABLED=true
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
DOCUMENT_WORKER_POLL_INTERVAL_SECONDS=1
