# Mirrored shared backend environment example for apps/api during the rebuild.
# The primary local template lives at apps/api/.env.example.

# App runtime
APP_NAME=Ragdoll API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SQL_ECHO=false
# Supports a single origin, comma-separated origins, or a JSON array of strings.
ALLOWED_ORIGINS=http://localhost:8030
API_HOST=0.0.0.0
API_PORT=8000

# Database
SUPABASE_DB_URL=postgresql://postgres:replace-with-local-postgres-password@db:5432/postgres
# Host-local alternative when not running inside Docker: postgresql://postgres:replace-with-local-postgres-password@localhost:15432/postgres
# Optional generic fallback if SUPABASE_DB_URL is omitted
# DATABASE_URL=postgresql://postgres:replace-with-local-postgres-password@db:5432/postgres
# Optional connection pool tuning
# DB_POOL_MODE=queue
# DB_POOL_SIZE=8
# DB_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=300
# DB_CONNECT_TIMEOUT_SECONDS=5
# Optional test database override
# SUPABASE_TEST_DB_URL=postgresql://postgres:replace-with-local-postgres-password@db:5432/postgres
# Enable test database usage when running shared-backend test flows
# RAGDOLL_USE_TEST_DB=false
# Optional legacy fallback fields if SUPABASE_DB_URL is omitted
# SUPABASE_POSTGRES_HOST=db
# SUPABASE_POSTGRES_PORT=5432
# SUPABASE_POSTGRES_DB=postgres
# SUPABASE_POSTGRES_USER=postgres
# SUPABASE_POSTGRES_PASSWORD=replace-with-local-postgres-password

# Supabase API / storage
SUPABASE_URL=http://kong:8000
# Host-local alternative when not running inside Docker: http://localhost:18000
# Optional anon key for clients or local debugging
# SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_STORAGE_BUCKET=documents
# Optional test storage bucket override
# SUPABASE_TEST_STORAGE_BUCKET=documents-test
# Enable test storage bucket usage when running shared-backend test flows
# RAGDOLL_USE_TEST_STORAGE_BUCKET=false

# Queue
REDIS_URL=redis://redis:6379/0
# Host-local alternative when not running inside Docker: redis://localhost:16379/0
DOCUMENT_PROCESSING_QUEUE_NAME=document-processing
DOCUMENT_PROCESSING_JOB_TIMEOUT_SECONDS=2700
DOCUMENT_PROCESSING_RESULT_TTL_SECONDS=86400
DOCUMENT_PROCESSING_FAILURE_TTL_SECONDS=604800
# Optional stage-specific processing timeouts
# DOCUMENT_PROCESSING_TIMEOUT_SECONDS_DEFAULT=600
# DOCUMENT_PROCESSING_TIMEOUT_SECONDS_EXTRACTION=2700

# Security
SECRET_KEY=replace-me-before-shared-runtime-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Shared E2E user
E2E_TEST_USER_EMAIL=tests@ragdoll.local
E2E_TEST_USER_PASSWORD=testpass123
E2E_TEST_USER_FULL_NAME=Ragdoll E2E Test User

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_WORKER_BASE_URL=http://ollama:11434
# Host-local alternative when not running inside Docker: http://localhost:13434
OLLAMA_MODEL=qwen3.5:0.8b
# Optional model overrides for orchestration and worker execution
# OLLAMA_ORCHESTRATOR_MODEL=qwen3.5:0.8b
# OLLAMA_WORKER_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional embedding dimension override for custom models
# OLLAMA_EMBEDDING_DIMENSIONS=768
ENTITY_EXTRACTION_MODE=auto
ENTITY_EXTRACTION_BATCH_SIZE=4
ENTITY_EXTRACTION_MAX_PARALLEL_BATCHES=2
OLLAMA_WORKER_TIMEOUT_SECONDS=120
OLLAMA_CHAT_TIMEOUT_SECONDS=45
OLLAMA_STATUS_CHAT_TIMEOUT_SECONDS=45
OLLAMA_CHAT_MAX_TOKENS=700
OLLAMA_CHAT_CONTEXT_WINDOW=4096
OLLAMA_CHAT_THINK=false

# Instance limits
# INSTANCE_LIMIT_DOCUMENTS=
# INSTANCE_LIMIT_MAX_FILE_SIZE_BYTES=104857600
# INSTANCE_LIMIT_CHUNKS=
# INSTANCE_LIMIT_STORAGE_BYTES=
# INSTANCE_LIMIT_TOKENS_5H=
# INSTANCE_LIMIT_TOKENS_WEEK=
# INSTANCE_LIMIT_RETRIEVAL_CHUNKS=20
# INSTANCE_LIMIT_OUTPUT_TOKENS=2400
# INSTANCE_LIMIT_PER_DOCUMENT_CHUNKS=2000

# Shared-backend and memory-backed E2E toggles
# E2E_SHARED_BACKENDS=false
# E2E_MEMORY_BACKENDS=false
