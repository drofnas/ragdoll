# Canonical backend environment example for apps/api during the rebuild.
# Copy values into a local, uncommitted env file when Phase 1 runtime wiring lands.

# Database
SUPABASE_DB_URL=postgresql://postgres:your_password@db.example.supabase.co:5432/postgres

# Supabase API / storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=documents

# App security
SECRET_KEY=replace-me-before-shared-runtime-use

# API server
BACKEND_PORT=8031
ALLOWED_ORIGINS=http://localhost:8030

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Runtime behavior
DEBUG=true
LOG_LEVEL=INFO
